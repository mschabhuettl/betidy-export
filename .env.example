# --- BeTidy account (used by betidy_extract.py) ---
BETIDY_EMAIL=you@example.com
BETIDY_PASSWORD=your-betidy-password

# --- Donetick (used by donetick_import.py) ---
DONETICK_URL=https://donetick.example.com
DONETICK_TOKEN=your-donetick-access-token

# --- Optional ---
# IANA timezone for due dates (default: UTC)
BETIDY_TZ=Europe/Vienna
# Hour of day (0-23) tasks become due (default: 8)
BETIDY_DUE_HOUR=8
